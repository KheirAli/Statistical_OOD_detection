"""
Run DPS or DDAD-style denoising on a single image with additive Gaussian noise.

Usage:
    # Mode 1 (DPS): y = x + sigma*noise, start from pure noise, DPS guidance
    python run_sampling.py --image path/to/image.png --sigma 0.1 --mode 1 --scale 0.5

    # Mode 2 (DDAD): forward-process x_clean to matching timestep, DDAD conditioning
    python run_sampling.py --image path/to/image.png --sigma 0.1 --mode 2 --w 2
"""

import argparse
import os

import matplotlib.pyplot as plt
import numpy as np
import torch
from omegaconf import OmegaConf
from PIL import Image
from torchvision import transforms

from samplers import DPSPosteriorSampling, DDADReconstruction
from unet import UNetModel


def load_image(path, image_size=256):
    """Load an image and transform to [-1, 1] tensor."""
    transform = transforms.Compose([
        transforms.Resize((image_size, image_size)),
        transforms.ToTensor(),                        # [0, 1]
        transforms.Lambda(lambda t: t * 2 - 1),       # [-1, 1]
    ])
    img = Image.open(path).convert("RGB")
    return transform(img).unsqueeze(0)  # [1, 3, H, W]


def tensor_to_numpy(t):
    """Convert a [-1, 1] image tensor to [0, 1] numpy for saving."""
    return t.detach().cpu().clamp(-1, 1).add(1).div(2).permute(0, 2, 3, 1).squeeze(0).numpy()


def main():
    parser = argparse.ArgumentParser("DPS / DDAD Denoising")
    parser.add_argument("--image", type=str, required=True, help="Path to clean input image")
    parser.add_argument("--sigma", type=float, default=0.1,
                        help="Gaussian noise std (in [-1,1] image scale)")
    parser.add_argument("--mode", type=int, required=True, choices=[1, 2],
                        help="1: DPS from pure noise | 2: DDAD from matched timestep")
    parser.add_argument("--scale", type=float, default=0.5,
                        help="DPS guidance scale (mode 1 only)")
    parser.add_argument("--w", type=float, default=2.0,
                        help="DDAD conditioning strength (mode 2 only)")
    parser.add_argument("--save_dir", type=str, default="results_dps", help="Output directory")
    parser.add_argument("--cfg", type=str,
                        default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.yaml"),
                        help="Path to config.yaml")
    parser.add_argument("--gpu", type=int, default=0, help="GPU index")
    args = parser.parse_args()

    # Config
    config = OmegaConf.load(args.cfg)
    config.model.device = f"cuda:{args.gpu}" if torch.cuda.is_available() else "cpu"
    device = config.model.device

    torch.manual_seed(config.model.seed)
    np.random.seed(config.model.seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(config.model.seed)

    # Build and load model
    if config.model.DDADS:
        unet = UNetModel(config.data.image_size, 32, dropout=0.3, n_heads=2,
                         in_channels=config.data.input_channel)
    else:
        unet = UNetModel(config.data.image_size, 64, dropout=0.0, n_heads=4,
                         in_channels=config.data.input_channel)

    ckpt_path = os.path.join(
        os.getcwd(), config.model.checkpoint_dir,
        config.data.category, str(config.model.load_chp),
    )
    unet = torch.nn.DataParallel(unet)
    if os.path.exists(ckpt_path):
        checkpoint = torch.load(ckpt_path, map_location=device)
        unet.load_state_dict(checkpoint)
        print(f"Loaded checkpoint from {ckpt_path}")
    else:
        print(f"WARNING: No checkpoint found at {ckpt_path}, using random weights")

    unet.to(device)
    unet.eval()

    # Load clean image
    x_clean = load_image(args.image, config.data.image_size).to(device)

    print(f"Image: {args.image}")
    print(f"Sigma: {args.sigma}")
    print(f"Mode:  {args.mode} ({'DPS from noise' if args.mode == 1 else 'DDAD from matched timestep'})")

    if args.mode == 1:
        # Mode 1: create noisy measurement y, run DPS from pure noise
        y = x_clean + args.sigma * torch.randn_like(x_clean)
        print(f"Scale: {args.scale}")

        sampler = DPSPosteriorSampling(unet, config)
        xs = sampler(y, scale=args.scale)
        x_recon = xs[-1]

        noisy_img = y  # for visualization

    else:
        # Mode 2: forward-process x_clean to matched timestep, run DDAD
        print(f"w:     {args.w}")

        sampler = DDADReconstruction(unet, config)
        xs = sampler(x_clean, sigma=args.sigma, w=args.w)
        x_recon = xs[-1]

        # For visualization, show what the noisy x_{t*} looks like
        noisy_img = xs[0]

    # Metrics
    mse = torch.mean((x_clean - x_recon) ** 2).item()
    psnr = -10 * np.log10(mse) if mse > 0 else float("inf")
    print(f"Reconstruction PSNR: {psnr:.2f} dB")

    # Save results
    os.makedirs(args.save_dir, exist_ok=True)

    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    titles = ["Clean", "Noisy" if args.mode == 1 else "x_{t*}", "Reconstruction"]
    images = [x_clean, noisy_img, x_recon]
    for ax, title, img in zip(axes, titles, images):
        ax.imshow(tensor_to_numpy(img))
        ax.set_title(title)
        ax.axis("off")
    fig.tight_layout()
    fig.savefig(os.path.join(args.save_dir, "comparison.png"), dpi=150, bbox_inches="tight")
    plt.close(fig)

    plt.imsave(os.path.join(args.save_dir, "clean.png"), tensor_to_numpy(x_clean))
    plt.imsave(os.path.join(args.save_dir, "noisy.png"), tensor_to_numpy(noisy_img))
    plt.imsave(os.path.join(args.save_dir, "recon.png"), tensor_to_numpy(x_recon))

    print(f"Results saved to {args.save_dir}/")


if __name__ == "__main__":
    main()
